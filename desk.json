{
  "_comment": "This project's adapter for the Desk. ${root} is this folder; ${<KEY>} is the environment variable KEY or the fallback under env. Commands are what the desk can run and record; shots are the project's own screenshot switches (optional); filter_command runs a filtered test (optional); design is the recipe/projection hook (optional). Delete what the project does not have.",
  "project": "Anvil",
  "python": "python",
  "tracker": "H:/Desk/tracker/tracker.py",
  "env": {},
  "docs": {
    "sheets": "docs/testing/manual-checks.md",
    "roadmap": "docs/roadmap.md",
    "guide": "docs/tracker/GUIDE.md"
  },
  "code": [
    {
      "label": "source",
      "dir": ".",
      "ext": [
        "py"
      ],
      "skip": [
        "__pycache__",
        "output",
        "media",
        "docs"
      ]
    }
  ],
  "tests": {
    "dir": "",
    "prefix": "",
    "logs": []
  },
  "media_sources": [
    {
      "label": "output",
      "path": "output",
      "depth": 1
    }
  ],
  "playtest_gate": [
    [
      "played",
      "They played it without help"
    ],
    [
      "understood",
      "They understood what to do"
    ],
    [
      "came_back",
      "They wanted to keep going"
    ]
  ],
  "builds": [
    "dev",
    "release"
  ],
  "commands": [
    {
      "name": "tracker-check",
      "label": "Tracker check",
      "group": "checks",
      "minutes": 1,
      "description": "Items well-formed, backlog.md current.",
      "program": "python",
      "args": [
        "H:/Desk/tracker/tracker.py",
        "check"
      ]
    },
    {
      "name": "render",
      "label": "Render backlog",
      "group": "tools",
      "minutes": 1,
      "description": "Regenerate docs/backlog.md from the items.",
      "program": "python",
      "args": [
        "H:/Desk/tracker/tracker.py",
        "render"
      ]
    },
    {
      "name": "profile-check",
      "label": "Profile check",
      "group": "checks",
      "minutes": 1,
      "description": "Validate profile.yaml and API key.",
      "program": "python",
      "args": [
        "cli.py",
        "check"
      ]
    }
  ]
}